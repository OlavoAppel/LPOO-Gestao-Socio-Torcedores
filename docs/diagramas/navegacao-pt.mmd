state "Início (/)" as Inicio
state "Jogos (/jogos)" as Jogos
state "Jogo (/jogos/id)" as Jogo
state "Compra (/ingressos)" as Compra
state "Ingresso comprado (/ingressos/sucesso)" as Sucesso
